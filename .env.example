# Copier ce fichier vers .env, puis renseigner des valeurs locales.
# Ces valeurs ne concernent QUE la base PostgreSQL locale de développement (Docker).
# Ne jamais committer le vrai fichier .env.
POSTGRES_USER=finance
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-local
POSTGRES_DB=finance_dev
POSTGRES_PORT=5432
