// Schéma Prisma — @finance/api
//
// Étape 5 (modèle corrigé) : journal financier global. Une transaction (dépense
// ou revenu) appartient à un UTILISATEUR, pas à un compte : elle est ventilée
// en zéro, une ou plusieurs ALLOCATIONS (TransactionAccountAllocation).
//
// Règles métier :
//  - montants TOUJOURS positifs en stockage (le sens est porté par `type`) ;
//  - allocations connues ⇒ Σ allocations = montant exactement (decimal.js) ;
//  - « compte inconnu » est un choix EXPLICITE de l'utilisateur (accountUnknown)
//    : aucune allocation, aucun impact sur les soldes ;
//  - la date d'occurrence est optionnelle (`occurredAt` nullable) : date saisie
//    OU « je ne sais plus » explicite (dateUnknown). On ne suppose JAMAIS
//    aujourd'hui automatiquement ;
//  - une EXPENSE a une catégorie connue OU « je ne sais plus » explicite
//    (categoryUnknown). Les revenus n'ont pas de catégorie de dépense ;
//  - suppression LOGIQUE (deletedAt) : une opération supprimée disparaît de
//    l'historique et n'impacte plus les soldes ;
//  - solde courant dérivé (jamais stocké) :
//      initialBalance + revenus actifs − dépenses actives + ajustements
//    cf. finance-core/ledger.
//
// ⚠ TRANSFERTS — à NE PAS modéliser comme « dépense source + revenu
// destination » (cela fausserait totaux, statistiques, budgets). Un transfert
// sera plus tard un type d'opération spécifique (source, destination, frais).
// Cette étape n'implémente PAS les transferts.
//
// Conventions Prisma 7 :
//  - générateur `prisma-client` (TypeScript) avec un output explicite vers
//    src/generated/prisma (dossier généré, ignoré par Git) ;
//  - moduleFormat "esm" : notre application est en ESM ("type": "module") ;
//  - l'URL de connexion (DATABASE_URL) est fournie via prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Types de comptes V1 (fixes). Chaque utilisateur a au plus un compte par type.
enum AccountType {
  BANK
  MVOLA
  ORANGE_MONEY
  AIRTEL_MONEY
  CASH
  SAVINGS
}

/// Devise principale de l'espace financier (tous les comptes standard partagent
/// cette devise afin que le "Total disponible" soit cohérent).
enum Currency {
  MGA
  EUR
  CAD
}

/// Sens d'une opération sur un compte : INCOME (revenu) ou EXPENSE (dépense).
/// Le montant stocké est TOUJOURS positif ; le signe est appliqué par la règle
/// financière de finance-core (dépense = flux sortant).
enum TransactionType {
  INCOME
  EXPENSE
}

/// Statut d'une dépense PLANIFIÉE (étape 6).
///
/// ⚠ Une dépense planifiée n'est PAS une dépense réelle : PENDING n'impacte
/// aucun solde, aucun total, aucune statistique. Elle ne devient une vraie
/// Transaction EXPENSE qu'après confirmation explicite (« Oui, payé »).
enum PlannedExpenseStatus {
  PENDING
  PAID
  CANCELED
  SKIPPED
}

/// Certitude d'un REVENU FUTUR (étape 7).
///
/// ⚠ Décrit la CERTITUDE du revenu attendu, jamais son statut de réception :
///  - CONFIRMED : l'utilisateur s'attend réellement à recevoir cet argent
///    (salaire annoncé, paiement client confirmé, …) ;
///  - UNCERTAIN : revenu espéré mais non garanti (bonus éventuel, client qui
///    pourrait payer, …). Toujours affiché distinctement, jamais traité comme
///    de l'argent garanti.
enum ExpectedIncomeCertainty {
  CONFIRMED
  UNCERTAIN
}

/// Statut de réception d'un REVENU FUTUR (étape 7).
///
///  - PENDING  : pas encore réellement reçu (aucun impact sur un solde) ;
///  - RECEIVED : une vraie Transaction INCOME a été créée (confirm-received) ;
///  - CANCELED : finalement plus attendu.
///
/// Le statut TEMPOREL (à venir / aujourd'hui / dans la période / en retard)
/// est TOUJOURS dérivé en lecture (finance-core), jamais stocké.
enum ExpectedIncomeStatus {
  PENDING
  RECEIVED
  CANCELED
}

/// Utilisateur de l'application (authentification email + mot de passe +
/// devise principale).
model User {
  id                 String                 @id @default(uuid()) @db.Uuid
  email              String                 @unique
  passwordHash       String
  currency           Currency               @default(MGA)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  refreshSessions    RefreshSession[]
  accounts           Account[]
  transactions       Transaction[]
  categories         Category[]
  accountAdjustments AccountAdjustment[]
  plannedExpenses    PlannedExpense[]
  recurringExpenses  RecurringExpenseRule[]
  expectedIncomes    ExpectedIncome[]
  monthlyBudgets     MonthlyBudget[]

  @@map("users")
}

/// Session de refresh (refresh token). Seul le hash SHA-256 est stocké.
model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

/// Catégorie d'une dépense.
///
/// Cette étape expose UNIQUEMENT les catégories système (`isSystem = true`,
/// `userId = null`), initialisées par un seed explicite et idempotent
/// (apps/api/prisma/seed.ts — jamais à la création d'un GET). `userId` nullable
/// prépare les futures catégories personnalisées. `code` est un slug stable
/// indépendant de la langue affichée (`name`).
model Category {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String                 @unique
  name              String
  isSystem          Boolean                @default(false)
  userId            String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  plannedExpenses   PlannedExpense[]
  recurringExpenses RecurringExpenseRule[]
  monthlyBudgets    MonthlyBudget[]

  @@index([userId])
  @@map("categories")
}

/// Compte financier manuel V1.
///
/// `initialBalance` = argent déclaré par l'utilisateur à la configuration
/// (le « solde de départ », saisi à la main). Le SOLDE COURANT affiché est
/// dérivé en lecture : initialBalance + revenus actifs − dépenses actives
/// (allocations du journal) + ajustements de solde (AccountAdjustment).
///
/// Dès qu'un compte possède au moins un mouvement (transaction active ou
/// ajustement), on ne modifie PLUS initialBalance : la saisie d'un solde
/// cible crée un AccountAdjustment (décision prise côté backend).
///
/// Montants stockés en NUMERIC (Decimal Prisma), jamais en flottant.
model Account {
  id             String                         @id @default(uuid()) @db.Uuid
  userId         String                         @db.Uuid
  type           AccountType
  currency       Currency
  initialBalance Decimal                        @default(0) @db.Decimal(20, 2)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations    TransactionAccountAllocation[]
  adjustments    AccountAdjustment[]

  // V1 : au plus un compte de chaque type par utilisateur.
  @@unique([userId, type])
  @@index([userId])
  @@map("accounts")
}

/// Opération financière (dépense ou revenu) du journal global d'un utilisateur.
///
/// Une transaction N'APPARTIENT PAS à un seul compte : sa répartition est
/// portée par TransactionAccountAllocation. `amount` est stocké POSITIF quel
/// que soit le sens (`type` porte le sens).
///
/// États « je ne sais plus » EXPLICITES (jamais un simple champ vide) :
///  - `accountUnknown`  : compte(s) inconnu(s) → aucune allocation ;
///  - `categoryUnknown` : catégorie inconnue (EXPENSE) → categoryId null ;
///  - `occurredAt null` : date inconnue (l'utilisateur a coché dateUnknown).
///
/// `occurredAt` est la date saisie (jour) ; composante horaire neutre (midi
/// UTC), ce qui évite tout décalage de fuseau. `deletedAt` = suppression
/// logique : la ligne reste en base mais disparaît de l'historique et des
/// soldes.
model Transaction {
  id                      String                         @id @default(uuid()) @db.Uuid
  userId                  String                         @db.Uuid
  type                    TransactionType
  amount                  Decimal                        @db.Decimal(20, 2)
  description             String?
  categoryId              String?                        @db.Uuid
  categoryUnknown         Boolean                        @default(false)
  accountUnknown          Boolean                        @default(false)
  occurredAt              DateTime?                      @db.Timestamp(3)
  deletedAt               DateTime?                      @db.Timestamp(3)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                Category?                      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  allocations             TransactionAccountAllocation[]
  // Relation 1-1 vers la dépense planifiée confirmée (étape 6) : une même
  // PlannedExpense ne peut générer qu'UNE seule Transaction active.
  confirmedPlannedExpense PlannedExpense?                @relation("PlannedExpenseConfirm")
  // Relation 1-1 vers le revenu futur confirmé reçu (étape 7) : un même
  // ExpectedIncome ne peut générer qu'UNE seule Transaction INCOME active.
  receivedExpectedIncome  ExpectedIncome?                @relation("ExpectedIncomeReceive")

  // userId redondant avec les allocations mais permet un scoping autorisé
  // simple et direct (requêtes par propriétaire sans jointure).
  @@index([userId, occurredAt])
  @@index([userId, createdAt])
  @@index([userId, deletedAt])
  @@map("transactions")
}

/// Ventilation d'une transaction sur un compte (zéro à plusieurs lignes).
///
/// « Somme des allocations = montant de la transaction » EXACTEMENT lorsque le
/// ou les comptes sont connus (vérifié en decimal.js, cf. finance-core).
/// Une transaction multi-comptes reste UNE SEULE transaction en historique.
model TransactionAccountAllocation {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  accountId     String      @db.Uuid
  amount        Decimal     @db.Decimal(20, 2)
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([transactionId, accountId])
  @@index([accountId])
  @@index([transactionId])
  @@map("transaction_account_allocations")
}

/// Ajustement manuel de solde (CORRECTION, ni dépense ni revenu).
///
/// Quand l'utilisateur déclare un solde réel différent du solde calculé, on
/// enregistre ici la différence (montant SIGNE : + ajoute, − retire). On ne
/// modifie JAMAIS l'historique des transactions, et ces ajustements ne
/// paraissent ni dans les dépenses ni dans les revenus.
model AccountAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  accountId String   @db.Uuid
  amount    Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("account_adjustments")
}

/// Règle de DÉPENSE MENSUELLE RÉCURRENTE (V1 — mensuelle uniquement, étape 6).
///
/// La règle n'est PAS une dépense réelle : elle génère des OCCURRENCES
/// (PlannedExpense, une par mois). Règles :
///  - `dayOfMonth` 1..31 ; si le mois n'a pas ce jour → LE DERNIER JOUR du
///    mois (31 en avril → 30, 31 en février → 28/29) — cf. finance-core ;
///  - horizon V1 : mois courant + 3 mois suivants (génération idempotente) ;
///  - `isActive = false` ⇒ plus aucune génération future (l'historique des
///    occurrences PAID / SKIPPED / CANCELED reste intact) ;
///  - la suppression logique d'une occurrence N'EXISTE pas : on annule
///    (CANCELED) ou on ignore (SKIPPED) l'occurrence concernée.
model RecurringExpenseRule {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  amount          Decimal          @db.Decimal(20, 2)
  currency        Currency         @default(MGA)
  dayOfMonth      Int
  categoryId      String?          @db.Uuid
  categoryUnknown Boolean          @default(false)
  description     String?
  /// Premier mois planifié (date calendaire ; l'échéance « jour 5 » d'un mois
  /// se place le 5 de ce mois si ≥ startDate, sinon le mois suivant).
  startDate       DateTime         @db.Date
  endDate         DateTime?        @db.Date
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences     PlannedExpense[]

  @@index([userId])
  @@map("recurring_expense_rules")
}

/// Dépense FUTURE (ponctuelle ou occurrence récurrente), étape 6.
///
/// ⚠ Une PlannedExpense PENDING n'impacte AUCUN solde : elle n'est pas une
/// Transaction. Elle devient une vraie Transaction EXPENSE UNIQUEMENT après
/// confirmation explicite (`confirmPaid`) :
///  1. la Transaction réelle (journal existant) est créée ;
///  2. l'occurrence passe PAID ;
///  3. `confirmedTransactionId` mémorise le lien.
/// L'opération est ATOMIQUE. La suppression logique de la Transaction liée
/// ramène l'occurrence à PENDING (jamais un état PAID orphelin).
model PlannedExpense {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @db.Uuid
  amount                 Decimal               @db.Decimal(20, 2)
  currency               Currency              @default(MGA)
  dueDate                DateTime              @db.Date
  categoryId             String?               @db.Uuid
  categoryUnknown        Boolean               @default(false)
  description            String?
  status                 PlannedExpenseStatus  @default(PENDING)
  recurringRuleId        String?               @db.Uuid
  confirmedTransactionId String?               @unique @db.Uuid
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category               Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule          RecurringExpenseRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  confirmedTransaction   Transaction?          @relation("PlannedExpenseConfirm", fields: [confirmedTransactionId], references: [id], onDelete: SetNull)

  // Une même règle ne peut générer DEUX FOIS la même échéance (génération
  // idempotente garantie au niveau base, indépendamment du scheduler).
  @@unique([recurringRuleId, dueDate])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([recurringRuleId, status])
  @@map("planned_expenses")
}

/// Revenu FUTUR (étape 7) : argent ATTENDU, jamais encore reçu.
///
/// ⚠ RÈGLE ABSOLUE : PENDING (CONFIRMED comme UNCERTAIN) n'est PAS de l'argent
/// disponible — aucun impact sur un compte, le Total disponible ou les
/// statistiques. Il devient une vraie Transaction INCOME UNIQUEMENT après la
/// confirmation explicite (`confirmReceived`) :
///  1. la Transaction INCOME réelle (journal existant, étape 5) est créée
///     (montant réel, date réelle ou « je ne sais plus », allocations réelles
///     ou « compte inconnu ») ;
///  2. le revenu passe RECEIVED ;
///  3. `receivedTransactionId` mémorise le lien (UNIQUE : un même revenu ne
///     peut jamais produire qu'UNE seule Transaction active, au niveau base).
/// L'opération est ATOMIQUE. La suppression logique de la Transaction liée
/// ramène le revenu à PENDING (jamais un état RECEIVED orphelin).
///
/// Temporellement, UNE seule forme est active (invariant service + Zod) :
///  - date EXACTE  : expectedDate (jour calendaire) ;
///  - PLAGE        : windowStart + windowEnd (les deux, start <= end).
/// Le système n'invente jamais une date exacte dans une plage. Le statut
/// temporel (à venir / aujourd'hui / dans la période / en retard) est DÉRIVÉ.
model ExpectedIncome {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @db.Uuid
  amount                Decimal                 @db.Decimal(20, 2)
  currency              Currency                @default(MGA)
  certainty             ExpectedIncomeCertainty
  status                ExpectedIncomeStatus    @default(PENDING)
  description           String?
  expectedDate          DateTime?               @db.Date
  windowStart           DateTime?               @db.Date
  windowEnd             DateTime?               @db.Date
  receivedTransactionId String?                 @unique @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedTransaction   Transaction?            @relation("ExpectedIncomeReceive", fields: [receivedTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, expectedDate])
  @@map("expected_incomes")
}

/// Budget mensuel (étape 8) — LIMITE / OBJECTIF analytique, JAMAIS de l'argent.
///
///  - `month` : mois calendaire « YYYY-MM » (texte ; jamais d'instant UTC) ;
///  - `categoryId` NULL  → budget GLOBAL du mois ;
///  - `categoryId` défini → budget de CETTE catégorie (catégories système) ;
///  - `amount` strictement positif (CHECK en base, cf. migration) ;
///  - devise de l'utilisateur au moment de la création ;
///  - le « montant dépensé » n'est JAMAIS stocké : il est DÉRIVÉ en lecture des
///    Transactions EXPENSE actives du mois. La source de vérité reste le
///    journal de transactions (étape 5). Un budget ne crée ni ne modifie
///    aucune Transaction, aucun compte, aucun solde, aucun Total disponible.
///
/// Unicité garantie en BASE par des index UNIQUES PARTIELS (créés dans la
/// migration, non exprimables dans le schéma Prisma) :
///  - 1 budget GLOBAL max par (userId, month)      → (userId, month)
///    WHERE categoryId IS NULL ;
///  - 1 budget par (userId, month, catégorie)      → (userId, month, categoryId)
///    WHERE categoryId IS NOT NULL.
model MonthlyBudget {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  month      String    @db.VarChar(7)
  amount     Decimal   @db.Decimal(20, 2)
  currency   Currency  @default(MGA)
  categoryId String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, month])
  @@map("monthly_budgets")
}
