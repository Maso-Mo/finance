// Schéma Prisma — @finance/api
//
// Étape 5 : transactions (dépenses/revenus). Le solde affiché d'un compte est
// dérivé : solde de départ saisi + revenus − dépenses (voir finance-core).
//
// Conventions Prisma 7 :
//  - générateur `prisma-client` (TypeScript) avec un output explicite vers
//    src/generated/prisma (dossier généré, ignoré par Git) ;
//  - moduleFormat "esm" : notre application est en ESM ("type": "module") ;
//  - l'URL de connexion (DATABASE_URL) est fournie via prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Types de comptes V1 (fixes). Chaque utilisateur a au plus un compte par type.
enum AccountType {
  BANK
  MVOLA
  ORANGE_MONEY
  AIRTEL_MONEY
  CASH
  SAVINGS
}

/// Devise principale de l'espace financier (tous les comptes standard partagent
/// cette devise afin que le "Total disponible" soit cohérent).
enum Currency {
  MGA
  EUR
  CAD
}

/// Sens d'une opération sur un compte : INCOME (revenu) ou EXPENSE (dépense).
/// Le montant stocké est TOUJOURS positif ; le signe est appliqué par la règle
/// financière de finance-core (dépense = flux sortant).
enum TransactionType {
  INCOME
  EXPENSE
}

/// Utilisateur de l'application (authentification email + mot de passe +
/// devise principale).
model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String
  currency        Currency         @default(MGA)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  accounts        Account[]
  transactions    Transaction[]

  @@map("users")
}

/// Session de refresh (refresh token). Seul le hash SHA-256 est stocké.
model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

/// Compte financier manuel V1.
///
/// `initialBalance` = argent déclaré par l'utilisateur à la configuration
/// (le « solde de départ », saisi à la main). Le SOLDE COURANT affiché est
/// dérivé en lecture : solde de départ + revenus − dépenses (transactions).
///
/// Montants stockés en NUMERIC (Decimal Prisma), jamais en flottant.
model Account {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  type           AccountType
  currency       Currency
  initialBalance Decimal       @default(0) @db.Decimal(20, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  // V1 : au plus un compte de chaque type par utilisateur.
  @@unique([userId, type])
  @@index([userId])
  @@map("accounts")
}

/// Opération (dépense ou revenu) rattachée à un compte.
///
/// `amount` est stocké POSITIF quel que soit le sens (`type` porte le sens).
/// `occurredAt` est la date saisie par l'utilisateur (jour de l'opération) ;
/// la composante horaire reste neutre (stockée à midi UTC à la création depuis
/// une date "YYYY-MM-DD"), ce qui évite tout décalage de fuseau horaire.
model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  accountId   String          @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(20, 2)
  description String?
  occurredAt  DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // userId est redondant avec accountId mais permet des requêtes autorisées
  // simples et directes (scoping par propriétaire sans jointure).
  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@map("transactions")
}
