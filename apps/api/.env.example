# Copier ce fichier vers .env et renseigner des valeurs locales.
# Le vrai fichier .env est ignoré par Git (cf. .gitignore). Aucun secret réel ici.

# Base de données locale de développement (PostgreSQL, docker compose à la racine).
DATABASE_URL="postgresql://finance:CHANGEME@localhost:5432/finance_dev?schema=public"

# --- Authentification ---
# Secret de signature des access token JWT (à générer : openssl rand -hex 32).
JWT_ACCESS_SECRET=replace-me-with-a-random-64-char-hex-secret
# Cookie refresh : true en production (HTTPS). En dev HTTP local => false.
COOKIE_SECURE=false

# --- Divers (valeurs par défaut si absentes) ---
NODE_ENV=development
# ACCESS_TOKEN_TTL=15m
# CORS_ORIGIN=http://localhost:5173

# --- Web Push (étape 12) — OPTIONNEL en local/test ---
# Sans ces clés, l'API reste utilisable : le centre de notifications interne
# fonctionne et /notifications/push-config renvoie pushAvailable: false.
# Générer une paire de clés VAPID :
#   pnpm --filter @finance/api exec web-push generate-vapid-keys
# La clé PRIVÉE ne doit JAMAIS être commitée ni exposée au frontend.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact RFC 8030 (mailto: ou https:) associé aux abonnements.
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@finance.local
# Cadence de la passe notifications (cron) — défaut : toutes les heures.
# NOTIFICATIONS_CRON=5 * * * *

# --- Assistant IA (étape 13) — OPTIONNEL en local/test ---
# Sans configuration, l'API financière fonctionne normalement et
# GET /assistant/status renvoie { available: false }.
# Le fournisseur doit être compatible OpenAI (POST /chat/completions) :
#   AI_BASE_URL=https://api.openai.com/v1      (ou endpoint compatible)
#   AI_API_KEY=                                 (NE JAMAIS commiter une clé réelle)
#   AI_MODEL=
# Timeout d'un appel fournisseur (ms) — défaut 30000.
# AI_TIMEOUT_MS=30000
