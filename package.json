{
  "name": "finance",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo — Assistant de gestion financière personnelle (web + api + packages partagés)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @finance/web dev",
    "dev:api": "pnpm --filter @finance/api dev"
  }
}


